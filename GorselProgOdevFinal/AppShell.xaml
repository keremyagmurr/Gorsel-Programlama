<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GorselProgOdevFinal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GorselProgOdevFinal"
    xmlns:views="clr-namespace:GorselProgOdevFinal.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="GorselProgOdevFinal">

    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="DarkGreen" Padding="20" HeightRequest="200">
            <Label Text="Kerem Yağmur" 
                   TextColor="White" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold"/>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.FlyoutItemIsVisible="False" />

    <FlyoutItem Title="Giriş" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
    </FlyoutItem>

    <FlyoutItem Title="Kurlar" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:CurrencyPage}" Route="CurrencyPage" />
    </FlyoutItem>

    <FlyoutItem Title="Haberler" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:NewsPage}" Route="NewsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Hava Durumu" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:WeatherPage}" Route="WeatherPage" />
    </FlyoutItem>

    <FlyoutItem Title="Yapılacaklar" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:TodoPage}" Route="TodoPage" />
    </FlyoutItem>

    <FlyoutItem Title="Ayarlar" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>

</Shell>