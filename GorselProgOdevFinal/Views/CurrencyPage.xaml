<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GorselProgOdevFinal.ViewModels"
             x:Class="GorselProgOdevFinal.Views.CurrencyPage"
             Title="Güncel Kurlar"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Yenile" Command="{Binding LoadCurrenciesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           Color="Orange"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           Margin="10"/>

        <Grid Grid.Row="0" ColumnDefinitions="2*,1.5*,1.5*,1*,0.5*" Padding="15,10" BackgroundColor="#1E1E1E">
            <Label Text="TÜR" TextColor="Orange" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="ALIŞ" TextColor="Orange" FontAttributes="Bold" HorizontalOptions="End"/>
            <Label Grid.Column="2" Text="SATIŞ" TextColor="Orange" FontAttributes="Bold" HorizontalOptions="End"/>
            <Label Grid.Column="3" Text="FARK" TextColor="Orange" FontAttributes="Bold" HorizontalOptions="End"/>
            <Label Grid.Column="4" Text="" />
        </Grid>

        <RefreshView Grid.Row="1" Command="{Binding LoadCurrenciesCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Currencies}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0" 
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}" 
                                Margin="5,2" Padding="10">

                            <Grid ColumnDefinitions="2*,1.5*,1.5*,1*,0.5*">

                                <Label Text="{Binding Name}" 
                                       TextColor="{AppThemeBinding Light=Blue, Dark=#00FFFF}" 
                                       VerticalOptions="Center" FontAttributes="Bold"/>

                                <Label Grid.Column="1" Text="{Binding Buying}" 
                                       TextColor="{AppThemeBinding Light=Blue, Dark=White}" 
                                       HorizontalOptions="End" VerticalOptions="Center"/>

                                <Label Grid.Column="2" Text="{Binding Selling}" 
                                       TextColor="{AppThemeBinding Light=Blue, Dark=White}" 
                                       HorizontalOptions="End" VerticalOptions="Center"/>

                                <Label Grid.Column="3" Text="{Binding ChangeRate}" 
                                       TextColor="Green" 
                                       HorizontalOptions="End" VerticalOptions="Center"/>

                                <Label Grid.Column="4" Text="▲" 
                                       TextColor="Green" 
                                       HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>