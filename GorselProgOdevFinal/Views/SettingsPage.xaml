<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgOdevFinal.Views.SettingsPage"
             Title="Ayarlar"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <VerticalStackLayout Spacing="25" Padding="30">

        <Label Text="Uygulama Ayarları" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="{AppThemeBinding Light=Black, Dark=White}"
               HorizontalOptions="Center"/>

        <BoxView HeightRequest="1" Color="Gray" Margin="0,0,0,20"/>

        <Border StrokeShape="RoundRectangle 10" 
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}"
                Padding="15">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout>
                    <Label Text="Karanlık Mod" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <Label Text="Temayı değiştirir" 
                           FontSize="12" 
                           TextColor="Gray"/>
                </VerticalStackLayout>

                <Switch Grid.Column="1" 
                        Toggled="ThemeSwitch_Toggled" 
                        x:Name="ThemeSwitch"
                        OnColor="LightGreen"
                        ThumbColor="{AppThemeBinding Light=White, Dark=Black}"/>
            </Grid>
        </Border>

        <Border StrokeShape="RoundRectangle 10" 
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}"
                Padding="15">
        </Border>

        <Button Text="ÇIKIŞ YAP"
                Clicked="LogoutButton_Clicked"
                BackgroundColor="#D32F2F"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,30,0,0"/>

    </VerticalStackLayout>
</ContentPage>